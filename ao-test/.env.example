# --- HyperBEAM node ---
# URL of the HyperBEAM node. The docker-compose services expose 8734 locally.
HB_URL=http://localhost:8734

# --- Process spawn config ---
# TxID of the published smoke lua module. Publish it once with:
#   WALLET_FILE=./test-keys/client-wallet.json bun run publish
# then paste the printed id here. (This is LUA SOURCE on Arweave — not a wasm
# module like legacynet used.) Known-good published build of lua/smoke.lua
# (2026-07-13): PE7IPW9y3vsfGzvt1I1ObDdhXZ9tdYrXrxkCPEEqyVw
MODULE=PE7IPW9y3vsfGzvt1I1ObDdhXZ9tdYrXrxkCPEEqyVw

# Scheduler address. Leave empty to auto-resolve from {HB_URL}/~meta@1.0/info/address
# (the node's own operator address). Set explicitly to override.
SCHEDULER=

# Authority address. Leave empty to use the node's operator address. (Unlike
# genesis-wasm there is no import-authorities list involved in lua compute.)
AUTHORITY=

# Retries for transient failures against flaky public nodes (default 3).
EVAL_RETRIES=3

# --- Arweave signing ---
# Path to an Arweave JWK keyfile; signs spawns/messages and module uploads.
WALLET_FILE=./path/to/wallet.json

# --- EVM signing ---
# Raw hex private key (0x-prefixed) for evm-spawn-test.ts.
EVM_PRIVATE_KEY=

# --- Module publishing ---
# Override the upload endpoint. Default tries up.arweave.net, then Turbo.
UPLOAD_URL=
# Gateway used to verify the module is fetchable (default https://arweave.net).
GATEWAY=
