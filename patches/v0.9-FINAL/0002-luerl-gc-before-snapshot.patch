 snapshot(Base, _Req, Opts) ->
     case hb_private:get(<<"state">>, Base, Opts) of
         not_found ->
             {error, <<"Cannot snapshot Lua state: state not initialized.">>};
         State ->
-            {ok, #{ <<"body">> => term_to_binary(luerl:externalize(State)) }}
+            %% Garbage-collect before serialising. Luerl frees table-store slots
+            %% only inside luerl_heap:gc/1 and never collects on its own, so an
+            %% uncollected VM retains every table the process has ever allocated
+            %% and this binary grows without bound even when the Lua-visible
+            %% state is a fixed size. Collecting a copy here leaves the running
+            %% VM untouched, so the only affected path is restore.
+            {ok, #{
+                <<"body">> =>
+                    term_to_binary(luerl:externalize(luerl:gc(State)))
+            }}
     end.

