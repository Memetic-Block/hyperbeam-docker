+    % this. They are applied to the ALREADY-CONVERTED `[{Key, Value}]' proplist, and
+    % `ensure_all_loaded/3's list clause numbers the list and recurses on each ELEMENT -- so each
+    % element is the whole `{Key, Value}' tuple, which is not a link, and its value is never
+    % examined. Links therefore survive inside every map that was converted to a proplist, which
+    % is every message.
+    %
+    % Loading here rather than reordering those calls keeps the traversal as it is and costs
+    % nothing when a message carries no links. A link encodes as the value it points at, which is
+    % what a link means, so a script sees an ordinary value and needs no link handling of its own.
+    %
+    % Same narrowness as the `{as, ...}' clause above, and for the same reason: only a term this
+    % code can interpret is converted. `{error, {device_not_loadable, _}}' still reaches the
+    % clause below and stays a hard failure, which `ao_core_sandbox_test' asserts.
+    do_encode(hb_cache:ensure_loaded(Link, Opts), Opts);
 do_encode(Other, _Opts) ->
     Other.
 
