     % error, and softening it is a security-relevant change that this fix does not need.
     do_encode(Msg#{ <<"device">> => DevID }, Opts);
+do_encode(Link, Opts) when ?IS_LINK(Link) ->
+    % A cache link. `do_encode/2' recurses through maps and lists and passes anything else
