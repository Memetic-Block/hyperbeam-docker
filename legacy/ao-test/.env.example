# --- HyperBEAM node ---
# URL of the HyperBEAM node. The docker-compose services expose 8734 locally.
HB_URL=http://localhost:8734

# --- Process spawn config ---
# AOS module TxID to spawn the test process from. Defaults to the genesis-wasm AOS
# module used in spawn-example-test.ts.
MODULE=ISShJH1ij-hPPt9St5UFFr_8Ys3Kj5cyg7zrMGt7H9s

# Scheduler address. Leave empty to auto-resolve from {HB_URL}/~meta@1.0/info/address
# (the node's own operator address). Set explicitly to override.
SCHEDULER=

# Authority address. Leave empty to auto-resolve the node's
# genesis-wasm-import-authorities (the separate authority node that actually
# computes the process). Only set this to override the auto-resolution.
AUTHORITY=

# Retries for transient eval failures against flaky public nodes (default 3).
EVAL_RETRIES=3

# --- Arweave signing (phase 1) ---
# Path to an Arweave JWK keyfile used to sign in arweave-spawn-eval-test.ts.
WALLET_FILE=./path/to/wallet.json

# --- EVM signing (phase 2) ---
# Raw hex private key (0x-prefixed) for evm-spawn-eval-test.ts.
# DEPLOYER_PRIVATE_KEY is also accepted (matches spawn-example-test.ts).
EVM_PRIVATE_KEY=
